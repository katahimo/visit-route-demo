{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "visit-route-demo",
  "compatibility_date": "2026-10-29",
  // 確認用 URL（<別名>-visit-route-demo.<サブドメイン>.workers.dev）を使う。ADR-0115
  "preview_urls": true,
  // 本番は独自ドメインだけで出し、<名前>.<サブドメイン>.workers.dev は出さない（管理画面の設定と合わせる。書かないと公開のたびに入になる）
  "workers_dev": false,
  "assets": {
    "directory": "./dist"
  },
  "routes": [{ "pattern": "staff-assign-demo.katahimo.com", "custom_domain": true }]
}
