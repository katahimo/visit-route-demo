    {
      "includes": ["src/seed/**", "!**/*.test.ts", "!**/*.test.tsx", "!**/*.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
