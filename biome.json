{
  "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/playwright-report",
      "!**/test-results",
      "!**/*.json",
      "!**/*.css",
      "!.claude"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off"
      },
      "complexity": {
        "noExcessiveLinesPerFunction": {
          "level": "warn",
          "options": {
            "maxLines": 150,
            "skipBlankLines": true
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.*", "**/*.spec.*", "e2e/**", "scripts/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          }
        }
      }
    },
    {
      "includes": ["src/contracts/**", "!**/*.test.ts", "!**/*.test.tsx", "!**/*.d.ts", "!src/contracts/documents.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "src/contracts/** は react に依存しない（code-rules.json）"
                },
                "patterns": [
                  {
                    "group": [
                      "**/domain",
                      "**/domain/**",
                      "**/lib",
                      "**/lib/**",
                      "**/store",
                      "**/store/**",
                      "**/components",
                      "**/components/**",
                      "**/pages",
                      "**/pages/**",
                      "**/app",
                      "**/app/**"
                    ],
                    "message": "src/contracts/** の層の決まりに反する import（code-rules.json）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/domain/**", "!**/*.test.ts", "!**/*.test.tsx", "!**/*.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "src/domain/** は react に依存しない（code-rules.json）"
                },
                "patterns": [
                  {
                    "group": [
                      "**/lib",
                      "**/lib/**",
                      "**/store",
                      "**/store/**",
                      "**/components",
                      "**/components/**",
                      "**/pages",
                      "**/pages/**",
                      "**/app",
                      "**/app/**",
                      "**/matching",
                      "**/matching/**",
                      "**/solver",
                      "**/solver/**"
                    ],
                    "message": "src/domain/** の層の決まりに反する import（code-rules.json）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/patterns/**", "!**/*.test.ts", "!**/*.test.tsx", "!**/*.d.ts"],
      "linter": {
