              "level": "error",
              "options": {
                "paths": {
                  "react": "src/lib/** は react に依存しない（code-rules.json）",
                  "react-dom": "src/lib/** は react-dom に依存しない（code-rules.json）"
                },
                "patterns": [
                  {
                    "group": [
                      "**/store",
                      "**/store/**",
