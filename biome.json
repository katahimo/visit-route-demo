    },
    {
      "includes": [
        "src/lib/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.d.ts",
        "!src/lib/dirtyForms.ts",
        "!src/lib/lazyComponent.tsx",
        "!src/lib/reloadPage.ts",
        "!src/lib/routeView.ts",
        "!src/lib/tentative.ts",
        "!src/lib/useDayModel.ts",
        "!src/lib/useDayStatuses.ts",
        "!src/lib/useFeature.ts",
        "!src/lib/useMedia.ts",
